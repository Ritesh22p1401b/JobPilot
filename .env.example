# Copy to backend/.env (scripts/setup.ps1 does this) and fill in the values. Never commit the copy.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (local Windows install, no Docker required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/jobpilot

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# LLM: any OpenAI-compatible endpoint. For Qwen3-8B on Colab, paste the tunnel URL and key
# printed by colab/qwen3_colab_server.ipynb. Edits to these LLM_* lines apply without restarting
# the API. A URL saved in Settings overrides them.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=180
LLM_DISABLE_THINKING=true
LLM_MAX_JOBS_PER_RUN=10

# Embeddings + vector store (local Qdrant)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=http://127.0.0.1:6333
QDRANT_ENABLED=true
QDRANT_COLLECTION_PREFIX=jobpilot_

# Job providers (public APIs only; LinkedIn/Indeed are never scraped)
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Authorized application submission: ONLY employer-issued keys, JSON map board/site -> key
GREENHOUSE_BOARD_API_KEYS={}
LEVER_POSTING_API_KEYS={}

# Worker: run inside the API process (dev) or separately via `python -m app.workers.worker`
EMBEDDED_WORKER=true

# Optional e-mail notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
